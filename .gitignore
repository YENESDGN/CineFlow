# Root .gitignore for Node (Frontend), Python (Backend), IDE/OS artifacts

# Node
node_modules/
**/node_modules/
coverage/
.npm/
.pnpm-store/
.vite/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
*.tsbuildinfo

# Env
.env
.env.*
*.local

# Frontend/Assets
*.DS_Store
*.cache

# Python
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE/OS
.vscode/
.idea/
*.iml
Thumbs.db
ehthumbs.db
desktop.ini

# Misc
.DS_Store
*.swp
*.swo

# Production/Build outputs
Backend/**/public/**
Frontend/**/public/profil-fotolari/*
!Frontend/**/public/profil-fotolari/.gitkeep

# Lock files should be committed; do not ignore package-lock.json
# package-lock.json
# poetry.lock
